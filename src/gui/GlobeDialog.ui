  <layout class="QVBoxLayout" name="globeLayout" stretch="1,0,0">
   <item>
    <widget class="GlobeView" name="globeView">
     <property name="toolTip">
      <string>Drag with the left button to turn the globe, and with the right to tilt the view; the wheel zooms</string>
     </property>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="controlsLayout">
     <item>
      <widget class="QCheckBox" name="orbitsCheck">
       <property name="text">
        <string>Orbits</string>
