      <widget class="QCheckBox" name="bordersCheck">
       <property name="text">
        <string>Borders</string>
       </property>
       <property name="toolTip">
        <string>Country borders, and state and province borders nearer the ground, from Natural Earth</string>
       </property>
       <property name="checked">
        <bool>true</bool>
       </property>
      </widget>
     </item>
     <item>
      <spacer name="controlsSpacer">
       <property name="orientation">
        <enum>Qt::Orientation::Horizontal</enum>
       </property>
       <property name="sizeHint" stdset="0">
        <size>
         <width>0</width>
         <height>0</height>
        </size>
       </property>
      </spacer>
     </item>
     <item>
      <widget class="QLabel" name="timeLabel">
       <property name="toolTip">
