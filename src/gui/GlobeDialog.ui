       </property>
       <property name="checked">
        <bool>true</bool>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QCheckBox" name="sightCheck">
       <property name="text">
        <string>Lines of sight</string>
       </property>
       <property name="toolTip">
        <string>From the receiver to each satellite above the elevation mask: the ones simulated</string>
       </property>
       <property name="checked">
        <bool>true</bool>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QCheckBox" name="gridCheck">
       <property name="text">
        <string>Grid</string>
       </property>
       <property name="toolTip">
        <string>Latitude and longitude every 15°</string>
